# Copie este arquivo para ".env" no mesmo diretório e preencha com valores reais.
# NUNCA commite o arquivo ".env" — ele fica de fora do git (veja .gitignore).

# ID da conta comercial/criador do Instagram (Instagram Business Account ID).
INSTAGRAM_BUSINESS_ID=

# ID da Página do Facebook vinculada a essa conta do Instagram.
FACEBOOK_PAGE_ID=

# Token de acesso de longa duração da Meta Graph API para essa Página/conta.
INSTAGRAM_ACCESS_TOKEN=

# Versão da Graph API usada nas chamadas.
META_API_VERSION=v19.0

# --- Hospedagem pública das imagens (a Graph API exige uma image_url pública) ---

# Estratégia padrão: "github" (recomendado) ou "catbox" (host público anônimo).
IMAGE_HOST_STRATEGY=github

# Necessário quando IMAGE_HOST_STRATEGY=github:
# Caminho local de um clone do repositório usado para hospedar as imagens.
IMAGE_HOST_REPO_DIR=

# Repositório no formato owner/repo (ex.: Reherrmann/vera).
IMAGE_HOST_GITHUB_REPO=

# Branch para onde as imagens são enviadas e de onde a URL pública é montada.
IMAGE_HOST_BRANCH=main

# Subpasta dentro do repositório onde as imagens publicadas são salvas.
IMAGE_HOST_SUBDIR=instagram-publisher/uploads
